# ==============================================================================
# PulseFit AI Staging Environment Configuration Template
# ==============================================================================
# Copy this file to staging/.env.staging and customize for your environment:
#   cp staging/.env.staging.example staging/.env.staging
# ==============================================================================

# Target Environment Selector: 'local' (Docker/native process) or 'remote' (Cloud)
STAGING_TARGET=local

# ------------------------------------------------------------------------------
# Supabase Configuration (Local Mock vs Remote Cloud)
# ------------------------------------------------------------------------------
# For Local Staging:
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=your-staging-anon-key-placeholder
SUPABASE_SERVICE_ROLE_KEY=your-staging-service-role-key-placeholder
JWT_SECRET=your-staging-jwt-secret-placeholder-32-chars

# For Remote Staging (Uncomment and replace with staging cloud keys if targeting cloud):
# SUPABASE_URL=https://<your-staging-project>.supabase.co
# SUPABASE_ANON_KEY=<your-remote-staging-anon-key>
# SUPABASE_SERVICE_ROLE_KEY=<your-remote-staging-service-role-key>

# ------------------------------------------------------------------------------
# Local Container & Service Port Bindings
# ------------------------------------------------------------------------------
BACKEND_PORT=8000
MOCK_SUPABASE_PORT=54321
POSTGRES_PORT=5432
POSTGREST_PORT=8080

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Relative path from staging/ to D:\Rag directory
RAG_CONTEXT_PATH=../../Rag

# ------------------------------------------------------------------------------
# RAG Microservice API Backend Configuration
# ------------------------------------------------------------------------------
RAG_API_URL=http://localhost:8000
PORT=8000
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# Stress & Load Testing Flags (Locust Concurrency Safeguards)
# ------------------------------------------------------------------------------
# When true, bypasses external Google Gemini & Cohere network roundtrips,
# returning realistic synthetic recommendations to allow benchmarking 500-1000+ users
# without hitting paid API rate limits (HTTP 429) or exhausting quotas.
MOCK_LLM_FOR_STRESS_TEST=true

# Optional simulated latency in milliseconds for mock LLM responses (0 = instantaneous)
MOCK_LLM_SYNTHETIC_LATENCY_MS=0

# ------------------------------------------------------------------------------
# External AI Services (Required only if MOCK_LLM_FOR_STRESS_TEST=false)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COHERE_API_KEY=

# ------------------------------------------------------------------------------
# Staging Seed Pipeline Defaults
# ------------------------------------------------------------------------------
STAGING_SEED_USERS=50
STAGING_SEED_WORKOUTS=200
TEST_USER_PASSWORD=your-staging-password-placeholder
