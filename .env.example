# ==============================================================================
# PulseFit Environment Configuration Template
# ==============================================================================
# Pass these values to Flutter using --dart-define during build/run:
#
#   flutter run \
#     --dart-define=SUPABASE_URL=https://your-project.supabase.co \
#     --dart-define=SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1... \
#     --dart-define=RAG_API_URL=https://fitness-rag-api.onrender.com
#
# Or set them in your VS Code launch.json / Android Studio run configurations.
# ==============================================================================

# Supabase Project URL (Supabase Dashboard -> Project Settings -> API)
SUPABASE_URL=https://your-project.supabase.co

# Supabase Anon / Publishable Key (Public client key protected by Row Level Security)
SUPABASE_ANON_KEY=your-anon-or-publishable-key-here

# RAG AI Recommendation Service API (FastAPI backend on Render or localhost)
# Default live cloud URL: https://fitness-rag-api.onrender.com
# Local development: http://10.0.2.2:8000 (Android Emulator) or http://127.0.0.1:8000 (iOS / Desktop / Web)
RAG_API_URL=https://fitness-rag-api.onrender.com
